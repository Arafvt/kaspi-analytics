# ── Kaspi Shop API ───────────────────────────────────────────
# X-Auth-Token из кабинета продавца Kaspi (Настройки → API)
KASPI_API_TOKEN=replace_me
KASPI_API_BASE=https://kaspi.kz/shop/api
KASPI_SYNC_INTERVAL=1800        # сек, фоновый синк заказов (раз в 30 мин)
KASPI_BACKFILL_DAYS=60          # на сколько дней назад тянуть при первом запуске
KASPI_PAGE_SIZE=100             # page[size] для пагинации заказов

# ── База данных ──────────────────────────────────────────────
DATABASE_URL=postgres://kaspi_user:kaspi_pass@kaspi_postgres:5432/kaspi_rnp
POSTGRES_USER=kaspi_user
POSTGRES_PASSWORD=kaspi_pass
POSTGRES_DB=kaspi_rnp

# ── Сервис ───────────────────────────────────────────────────
PORT=8080
TZ_OFFSET=+05                   # Asia/Almaty
TAX_RATE_DEFAULT=0.03           # дефолтная ставка налога (ИП упрощёнка)
LOG_LEVEL=info
