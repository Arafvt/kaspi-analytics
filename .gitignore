# ── Зависимости ──────────────────────────────────────────────
node_modules/

# ── Сборка / артефакты ───────────────────────────────────────
dist/
build/
.vite/
coverage/
*.tsbuildinfo

# ── Секреты и окружение (НЕ коммитим; .env.example — коммитим) ─
.env
.env.local
.env.*.local

# ── Логи ─────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── ОС / IDE ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# ── Референс-материалы 10X (содержимое не коммитим) ──────────
reference/*
!reference/.gitkeep

# ── Бизнес-выгрузки из кабинета Kaspi (реклама, себес и пр.) ──
# конфиденциальные данные продавца — содержимое не коммитим
data/*
!data/.gitkeep
